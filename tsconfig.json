{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    ".archgate/harness-config-core.d.ts",
    ".archgate/harness-config-extension.d.ts",
    "*.ts",
    "*.mts"
  ]
}
