{
  "version": "0.1.0",
  "markdown": {
    "frontmatter": {
      "unmatched": "exempt",
      "settings": { "draftEscape": true },
      "pathRules": [
        { "include": ["docs/adr/*.md"], "rule": { "allowedTypes": ["design-adr"], "label": "title" } },
        { "include": ["docs/agents/*.md"], "rule": { "allowedTypes": ["agent-doc"], "label": "title" } },
        {
          "include": [".archgate/adrs/*.md"],
          "rule": { "allowedTypes": ["adr"], "label": "title", "requireDescription": true }
        },
        {
          "include": [".claude/agents/*.md"],
          "rule": { "allowedTypes": ["agent"], "label": "name", "maxDescription": 4096 }
        },
        { "include": ["CONTEXT.md"], "rule": { "allowedTypes": ["context"], "label": "title" } },
        { "include": ["README.md"], "rule": { "allowedTypes": ["docs"], "label": "title" } },
        { "include": ["AGENTS.md"], "rule": { "allowedTypes": ["agents-md"], "label": "title" } },
        { "include": ["CLAUDE.md"], "rule": { "allowedTypes": ["claude-md"], "label": "title" } }
      ]
    }
  }
}
